    <Compile Include="..\RIMAPI\RimworldRestApi\Helpers\GrowingZoneLookup.cs" Link="Linked\GrowingZoneLookup.cs" />
    <!-- Why a map route has no map to report (fox ticket #3658): the sentence
         and the resolution are plain C#, the game's finder comes in as a
         function. -->
    <Compile Include="..\RIMAPI\RimworldRestApi\Helpers\MapLookup.cs" Link="Linked\MapLookup.cs" />
    <Compile Include="..\RIMAPI\RimworldRestApi\Helpers\TerrainRect.cs" Link="Linked\TerrainRect.cs" />
