<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>RIMAPI</RootNamespace>
    <AssemblyName>RIMAPI</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.10.0</Version>
  </PropertyGroup>

  <!-- RimWorld 1.6 is the only supported version (ticket #3285). The 1.5
       configuration is gone: it stopped compiling once 1.6-only APIs came in
       (PathFinder.FindPathNow, Blueprint.EntityToBuild, StatDefOf.Wildness),
       and the fox builds and installs the 1.6 assembly only. The symbol is
       set for every configuration, so Debug compiles the same branches. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_6</DefineConstants>
  </PropertyGroup>

  <!-- Conditional properties for RimWorld 1.6 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release-1.6'">
    <OutputPath>..\..\1.6\Assemblies\</OutputPath>
  </PropertyGroup>

  <!-- Default output path for Debug -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>

  <!-- A stale caller that still asks for Release-1.5 must fail loudly instead
       of quietly getting a 1.6 assembly (the unconditional reference above
       would let it compile). -->
  <Target Name="RejectRimWorld15" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release-1.5'">
    <Error Text="Release-1.5 was dropped (#3285): this mod builds only for RimWorld 1.6. Use -c Release-1.6." />
  </Target>

  <!-- Embed git hash into AssemblyInformationalVersion as "1.9.0+<hash>" -->
  <Target Name="SetSourceRevisionId" BeforeTargets="AddSourceRevisionToInformationalVersion">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true"
          WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitRevisionRaw" />
    </Exec>
    <PropertyGroup>
      <SourceRevisionId Condition="'$(_GitRevisionRaw.Trim())' != ''">$(_GitRevisionRaw.Trim())</SourceRevisionId>
      <SourceRevisionId Condition="'$(_GitRevisionRaw.Trim())' == ''">unknown</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <!-- RimWorld 1.6 reference assemblies; Debug uses the same ones, so it
         compiles the same branches a release does. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4518" />

    <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
    <Reference Include="Newtonsoft.Json, Version=13.0.0.0, Culture=neutral, PublicKeyToken=30ad4fe6b2a6aeed, processorArchitecture=MSIL">
      <HintPath>..\..\Libraries\Newtonsoft.Json.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>
</Project>
